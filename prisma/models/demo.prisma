model DemoClass {
  id            Int @id @default(autoincrement())

  tuitionPostId Int
  teacherId     Int
  studentId     Int

  assignedId    Int? @unique

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tuitionPost   TuitionPost @relation(fields: [tuitionPostId], references: [id], onDelete: Cascade)

  teacher       User @relation("TeacherDemoClasses", fields: [teacherId], references: [id])
  student       User @relation("StudentDemoClasses", fields: [studentId], references: [id])

  assigned      Assigned? @relation(fields: [assignedId], references: [id])

  @@map("demo_classes")
}