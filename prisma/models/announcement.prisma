model Announcement {
  id          String   @id @default(uuid())

  title       String
  message     String

  roles       Role[]

  startAt     DateTime
  endAt       DateTime

  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}