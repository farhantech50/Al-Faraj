model Announcement {
  id String @id @default(uuid())

  title   String
  message String

  roles Role[]

  startAt DateTime
  endAt   DateTime

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Assigned {
  id Int @id @default(autoincrement())

  tuitionPostId Int
  teacherId     Int
  studentId     Int
  assignedBy    Int

  isDemo      Boolean @default(true)
  isConfirmed Boolean @default(false)

  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tuitionPost TuitionPost @relation(fields: [tuitionPostId], references: [id], onDelete: Cascade)

  teacher User @relation("TeacherAssignments", fields: [teacherId], references: [id])
  student User @relation("StudentAssignments", fields: [studentId], references: [id])

  classSchedule ClassSchedule? @relation("AssignedClassSchedule")

  @@map("assigned_teacher_students")
}

model Assignment {
  id Int @id @default(autoincrement())

  teacherId Int
  studentId Int

  title       String
  description String?

  dueDate DateTime

  fileUrl  String?
  fileName String?

  note     String?
  grade    Int?
  feedback String?
  gradedAt DateTime?

  statusId  Int?
  subjectId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher User @relation("TeacherHomework", fields: [teacherId], references: [id])
  student User @relation("StudentHomework", fields: [studentId], references: [id])

  status  Lookup? @relation("AssignmentStatus", fields: [statusId], references: [id])
  subject Lookup? @relation("AssignmentSubjectLookup", fields: [subjectId], references: [id])

  @@map("assignments")
}

model ClassSchedule {
  id Int @id @default(autoincrement())

  assignedId Int @unique
  teacherId  Int
  studentId  Int

  days        Day[]
  startTime   String
  endTime     String
  meetingLink String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignment Assigned @relation(fields: [assignedId], references: [id], onDelete: Cascade, name: "AssignedClassSchedule")

  teacher User @relation("TeacherClassSchedules", fields: [teacherId], references: [id], onDelete: Cascade)
  student User @relation("StudentClassSchedules", fields: [studentId], references: [id], onDelete: Cascade)

  subjects ClassScheduleSubject[]
}

model ClassScheduleSubject {
  id Int @id @default(autoincrement())

  classScheduleId Int
  subjectId       Int

  classSchedule ClassSchedule @relation(fields: [classScheduleId], references: [id], onDelete: Cascade)
  subject       Lookup        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classScheduleId, subjectId])
  @@map("class_schedule_subjects")
}

enum Role {
  admin
  moderator
  teacher
  student
}

enum Gender {
  male
  female
  other
}

enum Mode {
  online
  offline
}

enum Day {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

model Lookup {
  id        Int      @id @default(autoincrement())
  name      String
  value     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tuitionStatuses       TuitionPost[]          @relation("TuitionStatus")
  applicationStatus     TuitionApplication[]   @relation("ApplicationStatus")
  assignmentStatus      Assignment[]           @relation("AssignmentStatus")
  assignmentSubject     Assignment[]           @relation("AssignmentSubjectLookup")
  TuitionPostArea       TuitionPost[]          @relation("TuitionPostArea")
  classScheduleSubjects ClassScheduleSubject[]
  subjects              TuitionPostSubject[]   @relation("SubjectLookup")

  @@map("lookups")
}

model RolePermission {
  id Int @id @default(autoincrement())

  role       Role
  permission String

  createdAt DateTime @default(now())

  @@unique([role, permission])
  @@map("role_permissions")
}

model StudentProfile {
  id     Int @id @default(autoincrement())
  userId Int @unique

  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode            Mode
  gradeLevel      Int?
  institution     String?
  guardianName    String?
  guardianAddress String?
  guardianContact String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_profiles")
}

model TeacherProfile {
  id     Int @id @default(autoincrement())
  userId Int @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio                   String?
  experienceYears       Int?
  educationalBackground String?
  cvUrl                 String?

  mode Mode

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teacher_profiles")
}

model TuitionPost {
  id     Int    @id @default(autoincrement())
  postId String @unique

  postedBy Int

  title       String
  description String?
  budget      Decimal?

  mode   Mode
  areaId Int

  days      Day[]
  startTime String
  endTime   String

  statusId Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postedByUser User @relation(fields: [postedBy], references: [id], onDelete: Cascade)

  status   Lookup               @relation("TuitionStatus", fields: [statusId], references: [id])
  area     Lookup?              @relation("TuitionPostArea", fields: [areaId], references: [id])
  subjects TuitionPostSubject[]

  applications TuitionApplication[]
  assigned     Assigned[]

  @@map("tuition_posts")
}

model TuitionApplication {
  id            Int    @id @default(autoincrement())
  applicationId String @unique

  tuitionPostId Int
  teacherId     Int
  statusId      Int @default(14)

  coverNote String?

  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tuitionPost TuitionPost @relation(fields: [tuitionPostId], references: [id], onDelete: Cascade)
  teacher     User        @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  status Lookup @relation("ApplicationStatus", fields: [statusId], references: [id])

  @@unique([tuitionPostId, teacherId])
}

model TuitionPostSubject {
  id Int @id @default(autoincrement())

  tuitionPostId Int
  subjectId     Int

  tuitionPost TuitionPost @relation(fields: [tuitionPostId], references: [id], onDelete: Cascade)
  subject     Lookup      @relation("SubjectLookup", fields: [subjectId], references: [id])

  @@unique([tuitionPostId, subjectId])
}

model User {
  id     Int     @id @default(autoincrement())
  userId String? @unique

  name     String
  email    String @unique
  password String

  address String?
  contact String?
  gender  Gender?
  role    Role

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]

  teacherProfile TeacherProfile?
  studentProfile StudentProfile?

  tuitionPosts TuitionPost[]
  applications TuitionApplication[]

  teacherAssignments Assigned[] @relation("TeacherAssignments")
  studentAssignments Assigned[] @relation("StudentAssignments")

  teacherHomework Assignment[] @relation("TeacherHomework")
  studentHomework Assignment[] @relation("StudentHomework")

  teacherSchedules ClassSchedule[] @relation("TeacherClassSchedules")
  studentSchedules ClassSchedule[] @relation("StudentClassSchedules")

  announcements Announcement[]

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@map("refresh_tokens")
}

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
}
